<!--
  ═══════════════════════════════════════════════════════════════════════════
  APIM Per-Operation Policy — GET /dashboard, GET /admin/*
  ═══════════════════════════════════════════════════════════════════════════
  Where to apply:
    Azure Portal → API Management → APIs → MedVoice API
    → GET /dashboard AND GET /admin/usage AND GET /admin/feedback
    → Inbound processing → paste this for each.

  Adds a ClinicalAdmin role gate ON TOP OF the global JWT validation.
  The global policy already requires Doctor OR ClinicalAdmin; this
  policy additionally rejects requests where the user only has Doctor.

  This is defence-in-depth: FastAPI's _require_admin() does the same check
  in Python, but APIM blocks it before the request even reaches the backend.
  ═══════════════════════════════════════════════════════════════════════════
-->
<policies>
  <inbound>
    <base />
    <!--
      Check ClinicalAdmin role specifically.
      The global policy's validate-jwt already verified the JWT is valid and
      that the user has Doctor OR ClinicalAdmin. Here we check for the
      stricter ClinicalAdmin-only requirement.
    -->
    <choose>
      <when condition='@{
        var roles = context.Request.Headers.GetValueOrDefault("X-User-Roles","");
        return !roles.Split(&#39;,&#39;).Any(r => r.Trim() == "ClinicalAdmin");
      }'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"detail": "ClinicalAdmin role required for dashboard access"}</set-body>
        </return-response>
      </when>
    </choose>
    <!-- Admin routes: 60/min (standard global) — no need to restrict further. -->
    <rate-limit-by-key
        calls="60"
        renewal-period="60"
        counter-key='@(context.Request.Headers.GetValueOrDefault("X-User-ID","anon"))'
        remaining-calls-header-name="X-RateLimit-Remaining"
        retry-after-header-name="X-RateLimit-Reset"
        increment-condition="@(context.Response.StatusCode != 429)" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
