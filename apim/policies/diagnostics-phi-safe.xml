<!--
  ═══════════════════════════════════════════════════════════════════════════
  APIM Diagnostic & Telemetry Policy — PHI-Safe Logging (No Request Bodies)
  ═══════════════════════════════════════════════════════════════════════════
  Purpose:
    Ensures zero clinical Protected Health Information (PHI) or audio
    transcripts are captured in APIM gateway logs, Application Insights,
    or Azure Monitor Log Analytics.

  Checklist Item:
    M1.3 #2 — Logs exclude request bodies

  Configuration details:
    • body-bytes="0" on both frontend and backend request & response
    • Captures HTTP status, latency, client IP, user ID, correlation ID
    • Explicitly strips sensitive headers and prevents body payload logging
  ═══════════════════════════════════════════════════════════════════════════
-->
<diagnostic>
  <logger-id>applicationinsights-medvoice</logger-id>
  <always-log-errors>true</always-log-errors>
  <sampling-percentage>100</sampling-percentage>
  <http-correlation-protocol>W3C</http-correlation-protocol>
  <verbosity>information</verbosity>
  <log-client-ip>true</log-client-ip>
  <frontend>
    <request>
      <headers>
        <header>X-User-ID</header>
        <header>X-Correlation-ID</header>
        <header>Content-Type</header>
        <header>User-Agent</header>
      </headers>
      <!-- CRITICAL: body bytes 0 ensures audio & transcript payloads are NEVER logged -->
      <data-masking>
        <headers>
          <header mode="mask" value="Authorization" />
          <header mode="mask" value="api-key" />
        </headers>
      </data-masking>
      <body bytes="0" />
    </request>
    <response>
      <headers>
        <header>Content-Type</header>
        <header>X-Correlation-ID</header>
        <header>X-RateLimit-Remaining</header>
      </headers>
      <!-- CRITICAL: zero response bytes prevents clinical diagnoses from entering logs -->
      <body bytes="0" />
    </response>
  </frontend>
  <backend>
    <request>
      <headers>
        <header>X-Correlation-ID</header>
        <header>Content-Type</header>
      </headers>
      <body bytes="0" />
    </request>
    <response>
      <headers>
        <header>Content-Type</header>
        <header>X-Correlation-ID</header>
      </headers>
      <body bytes="0" />
    </response>
  </backend>
</diagnostic>
