<!--
  ═══════════════════════════════════════════════════════════════════════════
  APIM Global Policy — applies to ALL APIs in this APIM instance
  ═══════════════════════════════════════════════════════════════════════════
  Where to apply:
    Azure Portal → API Management → APIs → "All APIs" → Inbound processing
    Paste this entire document into the policy editor.

  Named values required (Portal → Named values):
    {{TENANT_ID}}   — your Azure AD / Entra ID tenant GUID
    {{CLIENT_ID}}   — the App Registration client_id (audience)

  What this policy does, in order:
    1. CORS            — allow the two known origins; OPTIONS handled here,
                         not in FastAPI (FastAPI CORSMiddleware is removed).
    2. JWT validation  — Entra ID v2 token, requires Doctor or ClinicalAdmin role.
    3. Identity inject — extracts oid / preferred_username / name / roles from
                         the validated JWT and forwards them as X-User-* headers
                         so FastAPI never touches JWT crypto.
    4. Rate limit      — 60 calls/min per user (per-operation policies override).
    5. Correlation ID  — generates a short tracing ID if the caller didn't send one.
    6. Strip Authz     — removes the Authorization header before forwarding to
                         the VNet-internal FastAPI backend.
  ═══════════════════════════════════════════════════════════════════════════
-->
<policies>
  <inbound>

    <!-- ═══ 1. CORS ═══════════════════════════════════════════════════════ -->
    <!--
      allow-credentials="true" is required for the browser to send cookies /
      session tokens. preflight-result-max-age="300" means OPTIONS preflight
      responses are cached for 5 minutes — reduces latency on repeated calls.
    -->
    <cors allow-credentials="true">
      <allowed-origins>
        <origin>https://medical-voice-assistant.ahbsdev.com</origin>
        <origin>http://localhost:1110</origin>
        <origin>http://localhost:7777</origin>
        <origin>http://localhost:8586</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300">
        <method>GET</method>
        <method>POST</method>
        <method>PUT</method>
        <method>DELETE</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>Authorization</header>
        <header>Content-Type</header>
        <header>X-Correlation-ID</header>
        <header>X-Requested-With</header>
      </allowed-headers>
      <expose-headers>
        <header>X-Correlation-ID</header>
        <header>X-RateLimit-Remaining</header>
        <header>X-RateLimit-Reset</header>
      </expose-headers>
    </cors>

    <!-- ═══ 2. JWT VALIDATION (Entra ID v2) ══════════════════════════════ -->
    <!--
      failed-validation-httpcode="401" → browser gets 401, not 403, on bad/missing token.
      require-expiration-time="true"   → rejects tokens with no exp claim.
      require-scheme="Bearer"          → only accepts "Bearer <token>" format.
      The openid-config URL is the standard Entra ID v2 discovery endpoint.
      APIM fetches and caches the JWKS automatically; key rollover is handled.
    -->
    <validate-jwt
        header-name="Authorization"
        failed-validation-httpcode="401"
        failed-validation-error-message="Unauthorized: valid Bearer token with Doctor or ClinicalAdmin role required"
        require-expiration-time="true"
        require-scheme="Bearer"
        clock-skew-seconds="30">
      <openid-config url="https://login.microsoftonline.com/{{TENANT_ID}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>{{CLIENT_ID}}</audience>
        <audience>api://{{CLIENT_ID}}</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{TENANT_ID}}/v2.0</issuer>
        <issuer>https://sts.windows.net/{{TENANT_ID}}/</issuer>
      </issuers>
      <required-claims>
        <claim name="roles" match="any">
          <value>Doctor</value>
          <value>ClinicalAdmin</value>
          <value>ExecutiveStakeholder</value>
        </claim>
      </required-claims>
    </validate-jwt>

    <!-- ═══ 3. EXTRACT USER IDENTITY → X-User-* HEADERS ═════════════════ -->
    <!--
      These headers are the contract between APIM and FastAPI.
      FastAPI's core/auth.py reads them directly — no JWT library needed.
      exists-action="override" ensures a malicious caller cannot spoof these
      headers: APIM always overwrites with values extracted from the validated JWT.
    -->
    <set-header name="X-User-ID" exists-action="override">
      <value>@{
        var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt();
        return jwt?.Claims.GetValueOrDefault("oid", jwt?.Claims.GetValueOrDefault("sub","unknown")) ?? "unknown";
      }</value>
    </set-header>

    <set-header name="X-User-Email" exists-action="override">
      <value>@{
        var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt();
        return jwt?.Claims.GetValueOrDefault("preferred_username",
               jwt?.Claims.GetValueOrDefault("email","")) ?? "";
      }</value>
    </set-header>

    <set-header name="X-User-Name" exists-action="override">
      <value>@{
        var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt();
        return jwt?.Claims.GetValueOrDefault("name","") ?? "";
      }</value>
    </set-header>

    <set-header name="X-User-Roles" exists-action="override">
      <value>@{
        var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt();
        var roles = jwt?.Claims
            .Where(c => c.Type == "roles")
            .Select(c => c.Value)
            ?? new string[0];
        return String.Join(",", roles);
      }</value>
    </set-header>

    <!-- ═══ 4. GLOBAL RATE LIMIT (60/min per authenticated user) ══════════ -->
    <!--
      counter-key is the Entra OID (X-User-ID) — already set above.
      Per-operation policies (audio-analyze.xml, etc.) override this with
      stricter limits. Uses X-User-ID after it has been set by step 3.
      remaining-calls-header-name / retry-after-header-name give the client
      visible feedback on their quota.
    -->
    <rate-limit-by-key
        calls="60"
        renewal-period="60"
        counter-key='@(context.Request.Headers.GetValueOrDefault("X-User-ID","anon"))'
        remaining-calls-header-name="X-RateLimit-Remaining"
        retry-after-header-name="X-RateLimit-Reset"
        increment-condition="@(context.Response.StatusCode != 429)" />

    <!-- ═══ 5. CORRELATION ID (12-char hex, for distributed tracing) ════ -->
    <!--
      exists-action="skip" → if the browser already sends X-Correlation-ID we keep it.
      This propagates through to the FastAPI response (outbound section below)
      and into Application Insights traces in Phase 2.
    -->
    <set-header name="X-Correlation-ID" exists-action="skip">
      <value>@(Guid.NewGuid().ToString("N").Substring(0,12))</value>
    </set-header>

    <!-- ═══ 6. STRIP AUTHORIZATION HEADER ═══════════════════════════════ -->
    <!--
      The FastAPI backend is VNet-internal only. We still strip the JWT so it
      never reaches application code — defence-in-depth.
    -->
    <set-header name="Authorization" exists-action="delete" />

  </inbound>

  <backend>
    <!-- Pass the request to FastAPI with up to 120 s timeout (SSE streams). -->
    <forward-request timeout="120" follow-redirects="false" buffer-request-body="false" />
  </backend>

  <outbound>
    <!-- Echo the correlation ID back on every response for client-side tracing. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-Correlation-ID",""))</value>
    </set-header>
    <!-- Remove server-identification headers (security hardening). -->
    <set-header name="Server" exists-action="delete" />
    <set-header name="X-Powered-By" exists-action="delete" />
  </outbound>

  <on-error>
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-Correlation-ID",""))</value>
    </set-header>
  </on-error>

</policies>
