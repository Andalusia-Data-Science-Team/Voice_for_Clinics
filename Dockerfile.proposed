# Proposed replacement: Python 3.11 is required by project metadata and asyncio.timeout.
FROM python:3.11-slim

# ffmpeg is used by speech_service; pyodbc needs unixODBC; soundfile/librosa needs libsndfile.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 unixodbc-dev ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list -o /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql17 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
# .dockerignore excludes .env, PHI-bearing data, reports, caches, and local models.
COPY src/ ./
RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/uploads /app/logs \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 7777
CMD ["python", "app.py"]
