# ==============================================================================
# MedVoice Clinical Voice Assistant - Environment Configuration Template
# All values shown below are non-secret placeholders or safe local defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & STT PROVIDER SWITCHES (M2 Provider Layer)
# Zero-code switching: change backend without touching application code.
# LLM backend: foundry (default) | openrouter (future)
# STT backend: munsit (Arabic default) | voxtral (English default)
# ------------------------------------------------------------------------------
LLM_PROVIDER=foundry
STT_PROVIDER=munsit

LLM_TIMEOUT_S=45.0
LLM_CONNECT_TIMEOUT_S=5.0
LLM_TOTAL_TIMEOUT_S=300.0
LLM_MAX_ATTEMPTS=4
LLM_BACKOFF_MAX_S=8.0
LLM_RETRY_AFTER_MAX_S=30.0
LLM_LIMIT_DEFAULT=8
LLM_MAX_CONNECTIONS=100
LLM_MAX_KEEPALIVE_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 2. AZURE AI FOUNDRY (Primary Production Provider)
# Endpoints and credentials for Azure AI Foundry deployment runtime.
# ------------------------------------------------------------------------------
AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1
AI_FOUNDRY_KEY=your-azure-foundry-api-key
AI_FOUNDRY_API_VERSION=2024-06-01
AI_FOUNDRY_DEPLOYMENT=gpt-4o-mini
FOUNDRY_DEFAULT_EXTRACTION_MODEL=gpt-5.6-luna
FOUNDRY_DEFAULT_REASONING_MODEL=gpt-5.6-luna
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1
AZURE_PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/YourProject

# ------------------------------------------------------------------------------
# 2b. FOUNDRY MODEL PLAN (per-step deployment names + routing)
# Deployment names are used exactly as written. Fallback-only and router-only
# deployments are never selectable primaries in GET /models.
# ------------------------------------------------------------------------------
FOUNDRY_MODEL_REFINEMENT=DeepSeek-V3.2
FOUNDRY_MODEL_TRANSLATION=DeepSeek-V3.2
FOUNDRY_MODEL_EXTRACTION=gpt-5.6-luna
FOUNDRY_MODEL_EXTRACTION_FALLBACK=gpt-4.1-mini
FOUNDRY_MODEL_ROUTER=model-router
FOUNDRY_MODEL_REASONING_SIMPLE=gpt-5.6-luna
FOUNDRY_MODEL_REASONING_COMPLEX=gpt-5.6-sol
FOUNDRY_MODEL_REASONING_SIMPLE_FALLBACK=gpt-4.1-mini
FOUNDRY_MODEL_REASONING_COMPLEX_FALLBACK=gpt-5.6-terra
ROUTER_ENABLED=false
ROUTER_FAILURE_TIER=complex
# Per-deployment TPM quotas (unset = unknown; fill from the portal).
# FOUNDRY_QUOTA_TPM__GPT_5_6_LUNA=
# FOUNDRY_QUOTA_TPM__GPT_5_6_TERRA=
# FOUNDRY_QUOTA_TPM__GPT_5_6_SOL=
# FOUNDRY_QUOTA_TPM__GPT_4_1_MINI=
# FOUNDRY_QUOTA_TPM__DEEPSEEK_V3_2=
# FOUNDRY_QUOTA_TPM__MODEL_ROUTER=

# ------------------------------------------------------------------------------
# 3. AZURE IDENTITY & KEY VAULT (M1 Managed Identity & Secrets)
# Used for Entra ID authentication and Azure Key Vault integration.
# ------------------------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_KEY=your-azure-api-key-fallback
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
USE_KEY_VAULT=false

# ------------------------------------------------------------------------------
# 4. API MANAGEMENT (APIM) GATEWAY & DASHBOARD AUTH (M1 Gateway & M7 Dashboard)
# Gateway routing, JWT validation, and clinician dashboard authentication.
# ------------------------------------------------------------------------------
APIM_ENABLED=false
APIM_GATEWAY_URL=https://your-apim-gateway.azure-api.net
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-in-production
DEV_CORS=true

# ------------------------------------------------------------------------------
# 5. TELEMETRY & APPLICATION INSIGHTS (Azure Monitor)
# Structured logging, distributed tracing, and metrics for medical pipeline.
# ------------------------------------------------------------------------------
APPINSIGHTS_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://dc.services.visualstudio.com/
APPINSIGHTS_CLOUD_ROLE=MedVoice-API
APPINSIGHTS_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# 6. SPEECH-TO-TEXT (STT) PROVIDERS
# Transcription engines (Arabic medical: Munsit; streaming: Voxtral / Whisper).
# ------------------------------------------------------------------------------
MUNSIT_API_KEY=your-munsit-api-key
MISTRAL_API_KEY=your-mistral-api-key
GROQ_API_KEY=your-groq-api-key
FIREWORKS_API_KEY=your-fireworks-api-key
PRIVATE_STT_ENDPOINT=https://your-private-stt.internal/v1
PRIVATE_STT_KEY=your-private-stt-key

# ------------------------------------------------------------------------------
# 7. DATABASE, STORAGE & CELERY BACKGROUND WORKERS
# SQL connection, file storage, and admission control concurrency.
# ------------------------------------------------------------------------------
PATIENT_DB_UID=medvoice_user
PATIENT_DB_PWD=your-patient-db-password
PATIENT_DB_DRIVER=ODBC Driver 18 for SQL Server
USE_MANAGED_IDENTITY_SQL=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_FLOWER_PASSWORD=change-in-production
CELERY_TASK_SERIALIZER=json
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_ACKS_LATE=false
CELERY_WORKER_CONCURRENCY=2
UPLOAD_FOLDER=uploads
MAX_CONCURRENT_ANALYSES=20
MAX_CONCURRENT_WEBSOCKETS=50

# ------------------------------------------------------------------------------
# 7b. MONGODB CONFIGURATION (Phase 3 Session Persistence)
# ------------------------------------------------------------------------------
MONGODB_USER=medvoice_user
MONGODB_PASSWORD=your-secure-mongo-password
MONGODB_DATABASE=medvoice
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL=50
MONGODB_MIN_POOL=5
MONGODB_URI=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@localhost:27018/${MONGODB_DATABASE}?authSource=${MONGODB_AUTH_SOURCE}

# ------------------------------------------------------------------------------
# 8. OPENROUTER & LEGACY COMPATIBILITY
# Retained for evaluation benchmarks and legacy offline pipelines.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
extraction=your-extraction-key
refine=your-refine-key
speech=your-speech-key
questions=your-questions-key
translation=your-translation-key
